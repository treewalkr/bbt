TRACKER_BASE_URL=https://your-tracker.example/
TRACKER_USERNAME=
TRACKER_PASSWORD=
# Optional: reuse a device id so the tracker always sees the same device.
TRACKER_DEVICE_ID=
# Optional: site-specific names (defaults shown)
TRACKER_LIST_PATH=browse.php
TRACKER_DEVICE_COOKIE=did
TRACKER_HASH_PARAM=hash_id
# Optional: category id:name pairs in display order, quoted, e.g. "1:Movies,2:TV Series".
# Unset hides categories.
TRACKER_CATEGORIES=
# Optional: database file (default bbt.db)
BBT_DB=bbt.db
# Optional: room for saved posters and screenshots, kept in images/ next to the database (default 2048)
BBT_IMAGE_CACHE_MB=
